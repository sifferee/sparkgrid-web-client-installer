# Large files — uploaded via GitHub Releases, not in git
Output/
*.exe
__pycache__/
*.pyc

# Secrets — never commit API keys / tokens
secrets.local.ps1
secrets.*.local.ps1

# Data — databases, logs, dumps, browser profiles
*.db
*.db-journal
data/
logs/
ai_content_data/
browser_profiles/

